                maKhuyenMai: document.getElementById('carsEditVerPromo').value.trim() || null,
                duongDanAnh: verUrl || null
            };
        }

        console.log('Cars saving all - brand:', brandPayload, 'model:', modelPayload, 'version:', versionPayload);
        await carsApiPost('/api/admin/hangxe/save', brandPayload);
        await carsApiPost('/api/admin/dongxe/save', modelPayload);
        if (versionPayload) await carsApiPost('/api/admin/phienban/save', versionPayload);
        console.log('Cars all saved successfully');
        showToast('Đã lưu tất cả!');
        setTimeout(() => location.reload(true), 1500);
    } catch (e) { showToast('Lỗi lưu: ' + e.message, 'error'); console.error(e); }
}
