async function carsSaveAllFull() {
    try {
        const brandUrlInput = document.getElementById('carsEditBrandLogo');
        const brandFileInput = document.getElementById('carsEditBrandFile');
        let brandUrl = brandUrlInput.value.trim();
        { const f = carsFileOrCrop(brandFileInput, 'carsEditBrandFile'); if (f) brandUrl = await carsUploadFile(f, 'carsEditBrandFile'); }

        const modelUrlInput = document.getElementById('carsEditModelImage');
        const modelFileInput = document.getElementById('carsEditModelFile');
        let modelUrl = modelUrlInput.value.trim();
        { const f = carsFileOrCrop(modelFileInput, 'carsEditModelFile'); if (f) modelUrl = await carsUploadFile(f, 'carsEditModelFile'); }

        const verUrlInput = document.getElementById('carsEditVerImage');
        const verFileInput = document.getElementById('carsEditVerFile');
        let verUrl = verUrlInput.value.trim();
        { const f = carsFileOrCrop(verFileInput, 'carsEditVerFile'); if (f) verUrl = await carsUploadFile(f, 'carsEditVerFile'); }

        const brandPayload = {
