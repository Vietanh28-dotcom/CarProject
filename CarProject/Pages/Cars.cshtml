            tenHang: document.getElementById('carsEditBrandName').value.trim(),
            quocGia: document.getElementById('carsEditBrandCountry').value.trim(),
            duongDanLogo: brandUrl || null
        };
        const modelPayload = {
            maDong: parseInt(document.getElementById('carsEditModelId').value),
            tenDong: document.getElementById('carsEditModelName').value.trim(),
            maHang: parseInt(document.getElementById('carsEditModelBrand').value),
            kieuDang: document.getElementById('carsEditModelStyle').value,
            duongDanAnh: modelUrl || null
        };
        const verId = document.getElementById('carsEditVerId').value;
        let versionPayload = null;
        if (verId) {
