<script>
    window.showroomsRaw = @Html.Raw(
        System.Text.Json.JsonSerializer.Serialize(
            Model.ShowroomNguonTheoChiTiet
                .Select(kv => new
                {
                    chiTiet = kv.Key,
                    list = kv.Value.Select(o => new { o.MaChiNhanh, o.TenChiNhanh, o.CoSan, o.CoTheDieuChuyen })
                }),
            new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }
        )
    );

    window.thieuXeByDon = @Html.Raw(
        System.Text.Json.JsonSerializer.Serialize(
            Model.ThieuXeTheoDon
                .ToDictionary(kv => kv.Key.ToString(),
                    kv => kv.Value.Select(i => new { i.MaChiTiet, i.TenXe, i.SoLuongThieu, Showrooms = i.Showrooms.Select(s => new { s.MaChiNhanh, s.TenChiNhanh, s.CoSan, s.CoTheDieuChuyen }), DaGui = i.DaGui.Select(g => new { g.MaChiNhanh, g.TenChiNhanh, g.SoLuong }) })),
            new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }
        )
    );

    function openRejectModal(maChiTiet, tenXe, actionLabel) {
        document.getElementById('rejectMaChiTiet').value = maChiTiet;
        document.getElementById('rejectTenXe').value = tenXe;
        document.getElementById('rejectLyDo').value = '';
        document.getElementById('rejectTitle').textContent = actionLabel || 'Từ chối tiếp nhận xe';
        new bootstrap.Modal(document.getElementById('rejectModal')).show();
    }

    function escHtml(s) {
        return String(s == null ? '' : s)
            .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
    }

    // Modal Nhập hàng: liệt kê mọi loại xe còn thiếu của 1 đơn, mỗi loại chỉ nhập số lượng (mặc định = số còn thiếu)
    function openNhapHangOrder(maDonCoc) {
        var don = String(maDonCoc);
        var items = (window.thieuXeByDon || {})[don] || [];
        if (!items.length) return;
        document.getElementById('nhapHangDon').textContent = '#' + don;
        var rowsEl = document.getElementById('nhapHangRows');
        rowsEl.innerHTML = '';
        items.forEach(function (it) {
            var row = document.createElement('div');
            row.className = 'ql-bordered mb-2 p-2 d-flex justify-content-between align-items-center gap-2 flex-wrap';
            row.innerHTML =
                '<div style="flex:1 1 0;min-width:180px;">' +
                    '<div class="ql-strong" style="font-size:0.85rem;">' + escHtml(it.tenXe) + '</div>' +
                    '<div class="ql-muted" style="font-size:0.72rem;">Còn thiếu: <strong>' + it.soLuongThieu + '</strong> xe</div>' +
                '</div>' +
                '<div style="min-width:120px;">' +
                    '<label class="form-label mb-1" style="font-size:0.7rem;">Số lượng nhập</label>' +
                    '<input type="number" name="maChiTiet" value="' + it.maChiTiet + '" hidden />' +
                    '<input type="number" name="soLuongNhap" class="form-control form-control-sm" min="1" value="' + it.soLuongThieu + '" required />' +
                '</div>';
            rowsEl.appendChild(row);
        });
        new bootstrap.Modal(document.getElementById('nhapHangModal')).show();
    }

    // Modal Nhập hàng từ showroom khác: mỗi loại xe thiếu chọn showroom nguồn + số lượng + hiện tồn kho khả dụng
    function openDieuChuyenOrder(maDonCoc) {
        var don = String(maDonCoc);
        var items = (window.thieuXeByDon || {})[don] || [];
        if (!items.length) return;
        document.getElementById('dcDon').textContent = '#' + don;
        var rowsEl = document.getElementById('dcRows');
        rowsEl.innerHTML = '';
        items.forEach(function (it, idx) {
            var opts = it.showrooms || [];
            var row = document.createElement('div');
            row.className = 'ql-bordered mb-2 p-2';
            var selHtml = '<option value="">-- Chọn showroom nguồn --</option>';
            var daGiu = it.soLuongThieu > 0 ? it.soLuongThieu : 1;
            var daGuiInfo = '';
            var daGuiByShow = {};
            (it.daGui || []).forEach(function (g) {
                daGuiByShow[g.maChiNhanh] = g.soLuong;
                daGuiInfo += '<div class="ql-warning" style="font-size:0.72rem;margin-top:0.2rem;"><i class="fas fa-clock"></i> Đã gửi yêu cầu <strong>' + g.soLuong + '</strong> xe tới <strong>' + escHtml(g.tenChiNhanh) + '</strong> (chờ xác nhận)</div>';
            });
            opts.forEach(function (o) {
                var daOops = daGuiByShow[o.maChiNhanh] || 0;
                var conLai = Math.max(0, o.coSan - daOops);
                selHtml += '<option value="' + o.maChiNhanh + '" data-conlai="' + conLai + '">' + escHtml(o.tenChiNhanh) + ' (có ' + conLai + ' xe có thể xin)</option>';
            });
            row.innerHTML =
                '<input type="number" name="maChiTiet" value="' + it.maChiTiet + '" hidden />' +
                '<div class="ql-strong" style="font-size:0.85rem;">' + escHtml(it.tenXe) + ' <span class="text-danger">(còn thiếu ' + it.soLuongThieu + ' xe)</span></div>' +
                daGuiInfo +
                '<div class="row g-2 align-items-center mt-1">' +
                    '<div class="col-md-6">' +
                        '<label class="form-label mb-1" style="font-size:0.7rem;">Showroom nguồn</label>' +
                        '<select name="maChiNhanhNguon" class="form-select form-select-sm" onchange="dcRowInfo(this)" required>' + selHtml + '</select>' +
                    '</div>' +
                    '<div class="col-md-3">' +
                        '<label class="form-label mb-1" style="font-size:0.7rem;">Số lượng</label>' +
                        '<input type="number" name="soLuongDieuChuyen" class="form-control form-control-sm dc-qty" min="1" value="' + daGiu + '" required />' +
                    '</div>' +
                '</div>' +
                '<div class="ql-muted dc-row-info mt-1" style="font-size:0.72rem;"></div>';
            rowsEl.appendChild(row);
        });
        var listEl = document.getElementById('dcListNguon');
        listEl.innerHTML = '';
        var coDaGui = false;
        items.forEach(function (it) {
            (it.daGui || []).forEach(function (g) {
                coDaGui = true;
                var li = document.createElement('div');
                li.className = 'ql-bordered mb-1 p-2';
                li.style.borderLeft = '4px solid #93c5fd';
                li.innerHTML =
                    '<div class="d-flex justify-content-between align-items-center flex-wrap gap-2">' +
                        '<div><i class="fas fa-paper-plane text-info"></i> <strong>' + escHtml(it.tenXe) + '</strong></div>' +
                        '<div><strong>' + g.soLuong + '</strong> xe tới <strong>' + escHtml(g.tenChiNhanh) + '</strong> <span class="badge badge-waiting">Chờ xác nhận</span></div>' +
                    '</div>';
                listEl.appendChild(li);
            });
        });
        if (coDaGui) {
            listEl.innerHTML = '<div class="ql-strong mb-1 ql-muted" style="font-size:0.8rem;"><i class="fas fa-list"></i> Yêu cầu đã gửi cho đơn này</div>' + listEl.innerHTML;
        }
        new bootstrap.Modal(document.getElementById('dieuChuyenModal')).show();
    }

    function dcRowInfo(select) {
        var box = select.closest('.ql-bordered');
        var info = box.querySelector('.dc-row-info');
        var qty = box.querySelector('.dc-qty');
        var o = select.options[select.selectedIndex];
        if (o && o.value) {
            var conLai = parseInt(o.dataset.conlai || '0', 10);
            if (qty) { qty.max = Math.max(1, conLai); if (parseInt(qty.value, 10) > conLai) qty.value = conLai; }
            info.innerHTML = '<i class="fas fa-info-circle"></i> Showroom nguồn hiện có thể xin <strong>' + conLai + '</strong> xe (đã trừ yêu cầu đang chờ). Quản lý showroom đó sẽ xác nhận.';
        } else {
            if (qty) qty.removeAttribute('max');
            info.innerHTML = '';
        }
    }

    function openTuChoiDieuChuyen(maYeuCau, tenXe, tenShowroomDich) {
        document.getElementById('tcdMaYeuCau').value = maYeuCau;
        document.getElementById('tcdInfo').innerHTML = '<strong>Yêu cầu #' + maYeuCau + '</strong> - ' + tenXe + ' cho showroom: ' + tenShowroomDich;
        document.getElementById('tcdLyDo').value = '';
        new bootstrap.Modal(document.getElementById('tuChoiDieuChuyenModal')).show();
    }

    function openHuyYeuCau(maYeuCau, tenXe, soLuong) {
        document.getElementById('hyMaYeuCau').value = maYeuCau;
        document.getElementById('hyInfo').innerHTML = '<strong>Yêu cầu #' + maYeuCau + '</strong> - ' + escHtml(tenXe) + ' (x' + soLuong + ' xe)';
        new bootstrap.Modal(document.getElementById('huyYeuCauModal')).show();
    }

    var declineOrderIsXuly = false;
    function openDeclineOrder(maDonCoc, khachHang, isXuLy) {
        declineOrderIsXuly = isXuLy;
        document.getElementById('declineMaDonCoc').value = maDonCoc;
        document.getElementById('declineOrderInfo').innerHTML = '<strong>Đơn cọc #' + maDonCoc + '</strong> - Khách: ' + khachHang;
        document.getElementById('declineLyDo').value = '';
        new bootstrap.Modal(document.getElementById('declineOrderModal')).show();
    }

    function openCancelDeposit(maDonCoc, khachHang) {
        document.getElementById('cdMaDonCoc').value = maDonCoc;
        document.getElementById('cdHoTen').value = 'Đơn cọc #' + maDonCoc + ' - Khách: ' + khachHang;
        document.getElementById('cdLyDo').value = '';
        new bootstrap.Modal(document.getElementById('cancelDepositModal')).show();
    }

    var GIO_HANH_CHINH_BAT_DAU = 8;          // 08:00
    var GIO_HEN_MUON_NHAT = 14;              // tối đa 14:30 (ít nhất 3 tiếng trước khi hết giờ hành chính 17:30)
    var PHUT_HEN_MUON_NHAT = 30;

    function isGioHoptLe(d) {
        var hh = d.getHours(), mm = d.getMinutes();
        if (hh < GIO_HANH_CHINH_BAT_DAU) return false;
        if (hh > GIO_HEN_MUON_NHAT) return false;
        if (hh === GIO_HEN_MUON_NHAT && mm > PHUT_HEN_MUON_NHAT) return false;
        return true;
    }

    function confirmAccept(event) {
        var form = event.target.closest('form');
        var ngay = form ? form.querySelector('[name="ngayHenNhanXe"]') : null;
        if (ngay) {
            if (!ngay.value) {
                alert('Vui lòng chọn ngày/giờ hẹn gặp trước khi tiếp nhận đơn cọc.');
                event.preventDefault();
                return false;
            }
            var d = new Date(ngay.value);
            if (isNaN(d.getTime()) || d.getTime() < Date.now()) {
                alert('Không thể chọn thời điểm trong quá khứ. Vui lòng chọn giờ hẹn trong tương lai.');
                event.preventDefault();
                return false;
            }
            if (!isGioHoptLe(d)) {
                alert('Giờ hẹn phải nằm trong giờ hành chính (08:00) và phải ít nhất 3 tiếng trước khi hết giờ hành chính (tối đa 14:30). Vui lòng chọn lại.');
                event.preventDefault();
                return false;
            }
        }
        if (!confirm('Tiếp nhận toàn bộ đơn cọc này và gửi lịch hẹn cho khách?')) {
            event.preventDefault();
            return false;
        }
        return true;
    }

    document.addEventListener('DOMContentLoaded', function () {
        var minStr = new Date(Date.now() + 60000).toISOString().slice(0, 16);
        document.querySelectorAll('[name="ngayHenNhanXe"]').forEach(function (el) {
            el.min = minStr;
        });
    });
</script>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        if (typeof L === 'undefined') return;
        document.querySelectorAll('[data-map-latlng]').forEach(function (el) {
            var raw = el.getAttribute('data-map-latlng');
            var parts = raw ? raw.split(',') : [];
            var lat = parseFloat(parts[0]), lng = parseFloat(parts[1]);
            if (isNaN(lat) || isNaN(lng)) { el.style.display = 'none'; return; }
            var m = L.map(el, { zoomControl: false, attributionControl: false, scrollWheelZoom: false }).setView([lat, lng], 15);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '&copy; OpenStreetMap' }).addTo(m);
            L.marker([lat, lng]).addTo(m);
        });
    });

    var qlBigMap = null;
    var qlBigMarker = null;
    function openQlMap(latlng, diaDiem, maDon) {
        if (typeof L === 'undefined' || typeof bootstrap === 'undefined') return;
        var parts = latlng ? latlng.split(',') : [];
        var lat = parseFloat(parts[0]), lng = parseFloat(parts[1]);
        if (isNaN(lat) || isNaN(lng)) return;
        if (!qlBigMap) {
            qlBigMap = L.map('qlMap', { zoomControl: true, attributionControl: false }).setView([lat, lng], 16);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '' }).addTo(qlBigMap);
            qlBigMarker = L.marker([lat, lng]).addTo(qlBigMap);
        } else {
            qlBigMap.setView([lat, lng], 16);
            qlBigMarker.setLatLng([lat, lng]);
        }
        document.getElementById('qlMapTitle').textContent = 'Vị trí thu cọc' + (maDon || '');
        document.getElementById('qlMapInfo').textContent = diaDiem || '';
        var gl = document.getElementById('qlGoogleLink');
        if (gl) gl.href = 'https://www.google.com/maps?q=' + latlng;
        var modal = new bootstrap.Modal(document.getElementById('qlMapModal'));
        modal.show();
        setTimeout(function () { if (qlBigMap) qlBigMap.invalidateSize(); }, 250);
    }
</script>
