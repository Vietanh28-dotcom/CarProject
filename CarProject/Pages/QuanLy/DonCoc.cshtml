@page
@model CarProject.Pages.QuanLy.DonCocModel
@{
    ViewData["Title"] = "Quản lý đơn cọc";
    Layout = "_Layout";
}

<style>
    .ql-header { background: linear-gradient(135deg, #0d0d14, #161b2e); color: #fff; padding: 2rem 0; margin-bottom: 2rem; border-bottom: 1px solid rgba(255,255,255,0.06); }
    .ql-card { background: rgba(255,255,255,0.035); border: 1px solid rgba(255,255,255,0.08); border-radius: 14px; box-shadow: 0 8px 30px rgba(0,0,0,0.35); padding: 1.5rem; color: #fff; }
    .badge-waiting { background: rgba(245,158,11,0.18); color: #fbbf24; border: 1px solid rgba(245,158,11,0.3); }
    .badge-confirmed { background: rgba(34,197,94,0.15); color: #4ade80; border: 1px solid rgba(34,197,94,0.3); }
    .badge-rejected { background: rgba(239,68,68,0.16); color: #f87171; border: 1px solid rgba(239,68,68,0.3); }
    .badge-completed { background: rgba(99,102,241,0.16); color: #a5b4fc; border: 1px solid rgba(99,102,241,0.3); }
    .badge-cancelled { background: rgba(168,85,247,0.16); color: #d8b4fe; border: 1px solid rgba(168,85,247,0.3); }

    /* ---- chủ đề tối cho khu vực quản lý ---- */
    .ql-card .table { --bs-table-bg: transparent; --bs-table-color: #e6e6ea; --bs-table-border-color: rgba(255,255,255,0.08); }
    .ql-card .table-hover > tbody > tr:hover > * { background-color: rgba(255,255,255,0.05); color: #fff; }
    .ql-card .table thead th { color: rgba(255,255,255,0.55); font-weight: 600; border-bottom: 1px solid rgba(255,255,255,0.12); }
    .ql-card .table td { border-color: rgba(255,255,255,0.06); vertical-align: middle; }
    .ql-card .bi, .ql-card .fas { }
    .ql-dark-sub { color: rgba(255,255,255,0.55) !important; }
    .ql-dark-box { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.08); border-radius: 8px; padding: 0.5rem; }
    .ql-card .btn-close { filter: invert(1); }
    .ql-bordered { border:1px solid rgba(255,255,255,0.1); border-radius:8px; background:rgba(255,255,255,0.03); }
    .ql-muted { color: rgba(255,255,255,0.6); }
    .ql-strong { color: #fff; font-weight: 600; }
    .ql-danger { color: #f87171; }
    .ql-link { color:#93c5fd; }
    .ql-link:hover { color:#bfdbfe; }
    /* giữ nền tối + chữ trắng sáng cho bảng QL — bất kể theme tối/sáng */
    .ql-card { background:#0d0d14 !important; color:#fff !important; box-shadow:0 8px 30px rgba(0,0,0,0.35) !important; }
    .ql-card table, .ql-card .table, .ql-card .table-responsive, .ql-card .table-responsive .table { background:transparent !important; }
    .ql-card table { --bs-table-bg:transparent !important; --bs-table-color:#fff !important; --bs-table-border-color:rgba(255,255,255,0.08) !important; }
    .ql-card table th, .ql-card table td, .ql-card .table-responsive th, .ql-card .table-responsive td,
.ql-card .ql-strong, .ql-card .ql-muted, .ql-card h5, .ql-card h6, .ql-header, .ql-card .text-muted { color:#fff !important; background:transparent !important; border-color:rgba(255,255,255,0.08) !important; }
    /* chế độ sáng: nền xám + chữ đen cho khu vực QL */
    [data-theme="light"] .ql-card { background:#e9ebee !important; color:#1a1a1a !important; box-shadow:0 8px 30px rgba(0,0,0,0.1) !important; border-color:#d5d7db !important; }
    [data-theme="light"] .ql-card table { --bs-table-bg:transparent !important; --bs-table-color:#1a1a1a !important; --bs-table-border-color:#dadce0 !important; }
    [data-theme="light"] .ql-card table th, [data-theme="light"] .ql-card table td,
    [data-theme="light"] .ql-card .table-responsive th, [data-theme="light"] .ql-card .table-responsive td,
    [data-theme="light"] .ql-card .ql-strong, [data-theme="light"] .ql-card .ql-muted,
    [data-theme="light"] .ql-card h5, [data-theme="light"] .ql-card h6,
    [data-theme="light"] .ql-card .text-muted { color:#1a1a1a !important; background:transparent !important; border-color:#dadce0 !important; }
    [data-theme="light"] .ql-card .ql-link { color:#1d4ed8 !important; }
    [data-theme="light"] .ql-card table a { color:#1d4ed8 !important; }
    /* overrides form/alert/modal */
    .ql-card .form-control, .ql-card .form-select, .ql-modal .form-control, .ql-modal .form-select,
    .ql-modal .input-group-text {
        background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.14);
        color: #fff; color-scheme: dark;
    }
    .ql-card .form-control::placeholder, .ql-modal .form-control::placeholder { color: rgba(255,255,255,0.4); }
    .ql-card .input-group-text { background: rgba(255,255,255,0.08); color: #fff; }
    .ql-card .form-select option, .ql-modal .form-select option { background: #161a26; color: #fff; }
    .ql-alert-success { background: rgba(34,197,94,0.14); border:1px solid rgba(34,197,94,0.3); color:#86efac; }
    .ql-alert-warn { background: rgba(245,158,11,0.15); border:1px solid rgba(245,158,11,0.3); color:#fcd34d; }
    .ql-modal .modal-content { background: #161a26; color:#fff; border:1px solid rgba(255,255,255,0.1); }
    .ql-modal .modal-header { border-bottom:1px solid rgba(255,255,255,0.08); }
    .ql-modal .modal-footer { border-top:1px solid rgba(255,255,255,0.08); }
    .ql-modal .btn-secondary { background:#2a2f40; border-color:#3a4056; color:#fff; }
    .ql-modal .form-label { color:#e6e6ea; }
    .ql-modal .text-muted { color: rgba(255,255,255,0.5) !important; }
</style>

<div class="ql-header">
    <div class="container">
        <h1 style="font-size: 1.5rem; font-weight: 600; margin: 0;">
            <i class="fas fa-file-invoice me-2"></i> Quản lý đơn cọc
        </h1>
        @if (Model.Showroom != null)
        {
            <p class="mb-0 mt-1" style="opacity: 0.7;">Showroom: <strong>@Model.Showroom.TenChiNhanh</strong></p>
        }
    </div>
</div>

<div class="container" style="padding-bottom: 3rem;">
    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert ql-alert-success">@Model.SuccessMessage</div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert ql-alert-warn">@Model.ErrorMessage</div>
    }

    @if (Model.Showroom != null)
    {
        <div class="ql-card mb-3" style="padding:1rem 1.5rem;">
            <div class="row g-2 align-items-center">
                <div class="col-md-4">
                    <div class="ql-muted" style="font-size:0.75rem;"><i class="fas fa-store me-1"></i> Showroom gặp mặt</div>
                    <div class="ql-strong">@Model.Showroom.TenChiNhanh</div>
                </div>
                <div class="col-md-5">
                    <div class="ql-muted" style="font-size:0.75rem;"><i class="fas fa-map-marker-alt me-1"></i> Địa chỉ</div>
                    <div class="ql-strong">@Model.Showroom.DiaChi, @Model.Showroom.ThanhPho</div>
                </div>
                <div class="col-md-3">
                    <div class="ql-muted" style="font-size:0.75rem;"><i class="fas fa-phone me-1"></i> Hotline</div>
                    <div class="ql-strong"><a class="ql-link" href="tel:@Model.Showroom.DuongDayNong">@Model.Showroom.DuongDayNong</a></div>
                </div>
            </div>
        </div>
    }

    @{
        // Yêu cầu điều chuyển mà showroom của TÔI là NGUỒN (tôi phải Xác nhận/Từ chối).
        // Đơn của các yêu cầu này có thể thuộc showroom ĐÍCH → không nằm trong DanhSachDonCoc của tôi,
        // nên hiển thị thành section độc lập (tránh bị "chỉ nhận thông báo, không thấy nút xác nhận").
        var maDonsToiQuanLy = Model.DanhSachDonCoc.Select(x => x.MaDonCoc).ToHashSet();
        var ycDenCanXuLy = Model.DanhSachYeuCauDen
            .Where(y => y.TrangThai == "Chờ xác nhận")
            .Where(y => !maDonsToiQuanLy.Contains(y.MaDonCoc))
            .OrderByDescending(y => y.NgayGui)
            .ToList();
    }

    @if (ycDenCanXuLy.Any())
    {
        <div class="ql-card mb-3" style="padding:1rem 1.5rem;">
            <h5 style="margin:0 0 0.75rem;"><i class="fas fa-truck-moving me-2 text-warning"></i> Yêu cầu điều chuyển đến showroom của bạn</h5>
            <small class="ql-muted d-block mb-3" style="font-size:0.8rem;">Showroom khác cần xe từ showroom của bạn. Hãy Xác nhận để chuyển xe, hoặc Từ chối (bắt buộc nhập lý do).</small>
            @foreach (var yc in ycDenCanXuLy)
            {
                var ycTen = $"{yc.ChiTiet?.PhienBan?.DongXe?.TenDong ?? ""} {yc.ChiTiet?.PhienBan?.TenPhienBan ?? ""}".Trim();
                var donOfYc = Model.DanhSachDonCoc.FirstOrDefault(d => d.MaDonCoc == yc.MaDonCoc);
                var donStatusText = donOfYc != null
                    ? $"<strong>#@yc.MaDonCoc</strong>"
                    : $"<strong>#@yc.MaDonCoc</strong> <small class='ql-muted'>(thuộc showroom khác)</small>";
                <div class="ql-bordered mb-2" style="padding:0.75rem;border-left:4px solid #fbbf24;">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <div>
                            <div><strong class="ql-strong">@ycTen</strong> <span class="text-warning">x@(yc.SoLuong) xe</span></div>
                            <div class="ql-muted" style="font-size:0.75rem;">
                                Yêu cầu từ: <strong class="ql-strong">@(yc.ChiNhanhDich?.TenChiNhanh ?? yc.MaChiNhanhDich)</strong>
                                → showroom của bạn (@(yc.ChiNhanhNguon?.TenChiNhanh ?? yc.MaChiNhanhNguon)) ·
                                Đơn cọc @Html.Raw(donStatusText) · Gửi lúc @yc.NgayGui.ToString("dd/MM/yyyy HH:mm")
                            </div>
                        </div>
                        <div class="d-flex flex-wrap gap-2" id="yc-@yc.MaYeuCau">
                            <form method="post" asp-page-handler="XacNhanDieuChuyen" onsubmit="return confirm('Xác nhận điều chuyển @yc.SoLuong xe này? Xe sẽ được chuyển sang showroom đích.');">
                                <input type="hidden" name="maYeuCau" value="@yc.MaYeuCau" />
                                <button type="submit" class="btn btn-success btn-sm"><i class="fas fa-check"></i> Xác nhận điều chuyển</button>
                            </form>
                            <button type="button" class="btn btn-danger btn-sm" onclick="openTuChoiDieuChuyen(@yc.MaYeuCau, '@(ycTen.Replace("'", "\\'"))', '@(yc.ChiNhanhDich?.TenChiNhanh ?? yc.MaChiNhanhDich)')">
                                <i class="fas fa-times"></i> Từ chối
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @if (!Model.DanhSachDonCoc.Any())
    {
        <div class="text-center py-5">
            <div style="font-size: 3rem; margin-bottom: 1rem; opacity: 0.2;"><i class="fas fa-file-invoice"></i></div>
            <h4 style="color: #e6e6ea;">Chưa có đơn cọc nào</h4>
        </div>
    }
    else
    {
        <div class="ql-card">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Mã đơn</th>
                            <th>Khách hàng</th>
                            <th>Xe</th>
                            <th>Tiền cọc</th>
                            <th>Ngày tạo</th>
                            <th>Trạng thái</th>
                            <th>Vị trí thu cọc</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in Model.DanhSachDonCoc)
                        {
                            <tr>
                                <td>#@d.MaDonCoc</td>
                                <td><strong>@d.HoTen</strong><br><small class="text-muted">@d.SoDienThoai</small></td>
                                <td>
                                    @foreach (var ct in d.ChiTiets)
                                    {
                                        var ctTen = $"{ct.PhienBan?.DongXe?.TenDong ?? ""} {ct.PhienBan?.TenPhienBan ?? ""}".Trim();
                                        var isMine = ct.MaChiNhanh == Model.Showroom?.MaChiNhanh;
                                        var tienNhanBadge = ct.TrangThaiTiepNhan switch
                                        {
                                            "Đã tiếp nhận" => "<span class='badge badge-confirmed'>Đã tiếp nhận</span>",
                                            "Từ chối" => $"<span class='badge badge-rejected'>Từ chối</span><br><small class='text-muted'>{(ct.LyDoTuChoi ?? "")}</small>",
                                            _ => "<span class='badge badge-waiting'>Chờ xác nhận</span>"
                                        };
<div class="ql-bordered" style="padding:0.5rem;margin-bottom:0.4rem;">
                                            <div>@ctTen <small class="text-muted">x@(ct.SoLuong)</small> @Html.Raw(tienNhanBadge)</div>
                                            <div class="ql-muted" style="font-size:0.7rem;">Showroom: @(ct.ChiNhanh?.TenChiNhanh ?? ct.MaChiNhanh)@(isMine ? " (của bạn)" : "")</div>
                                            @if (ct.SoLuongThieu > 0)
                                            {
                                                <div class="ql-danger" style="font-size:0.72rem;">
                                                    Cần nhập thêm: <strong>@ct.SoLuongThieu xe</strong>
                                                    @if (ct.DaNhapKho)
                                                    {
                                                        <span class="badge badge-confirmed">Đã nhập đủ</span>
                                                    }
                                                </div>
                                            }
                                            @if (isMine && ct.TrangThaiTiepNhan == "Chờ xác nhận" && (d.PhuongThucThanhToan != "Tiền mặt" || d.TrangThaiThanhToan == "Đã thanh toán"))
                                            {
                                                var isReceive = ct.MaChiNhanh == d.MaChiNhanh;
                                                var kiemTraXong = ct.CanNhapHang;
                                                @if (!kiemTraXong)
                                                {
                                                    <div style="margin-top:0.4rem;">
                                                        <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap">
                                                            <form method="post" asp-page-handler="Accept" style="flex:1 1 0; min-width:120px;" onsubmit="return confirm('@(isReceive ? "Tiếp nhận xe này?" : "Đồng ý vận chuyển xe này?")');">
                                                                <input type="hidden" name="maChiTiet" value="@ct.MaChiTiet" />
                                                                <button type="submit" class="btn btn-success btn-sm w-100"><i class="fas fa-check"></i> @(isReceive ? "Tiếp nhận" : "Đồng ý vận chuyển")</button>
                                                            </form>
                                                            <button type="button" class="btn btn-danger btn-sm" style="flex:1 1 0; min-width:120px; white-space:nowrap;" onclick="openRejectModal(@ct.MaChiTiet, '@(ctTen.Replace("'", "\\'"))', @(isReceive ? "'Không tiếp nhận'" : "'Từ chối vận chuyển'"))">
                                                                <i class="fas fa-times"></i> @(isReceive ? "Không tiếp nhận" : "Từ chối vận chuyển")
                                                            </button>
                                                        </div>
                                                        <div class="ql-danger" style="font-size:0.72rem;margin-top:0.3rem;">Bấm Tiếp nhận để hệ thống kiểm tra tồn kho của showroom.</div>
                                                    </div>
                                                }
                                                else
                                                {
                                                    @if (ct.SoLuongThieu > 0)
                                                    {
                                                        <div class="ql-danger" style="font-size:0.8rem;margin-top:0.3rem;">
                                                            <i class="fas fa-exclamation-triangle"></i> Showroom không đủ xe. Chỉ còn <strong>@(ct.SoLuong - ct.SoLuongThieu)</strong>/@ct.SoLuong xe. Hãy dùng nút Xử lý thiếu xe ở cột Thao tác.
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="ql-muted" style="font-size:0.8rem;margin-top:0.3rem;">
                                                            <i class="fas fa-check-circle text-success"></i> Đã đủ xe sau nhập/điều chuyển, hãy Tiếp nhận.
                                                        </div>
                                                    }
                                                }
                                            }
                                        </div>
                                    }
                                    @{
                                        var ycDenCuaDon = Model.DanhSachYeuCauDen.Where(y => y.MaDonCoc == d.MaDonCoc).ToList();
                                    }
                                    @if (ycDenCuaDon.Any())
                                    {
                                        foreach (var yc in ycDenCuaDon)
                                        {
                                            var ycTen = $"{yc.ChiTiet?.PhienBan?.DongXe?.TenDong ?? ""} {yc.ChiTiet?.PhienBan?.TenPhienBan ?? ""}".Trim();
                                            <div class="ql-bordered" style="padding:0.5rem;margin-bottom:0.4rem;border-left:4px solid #fbbf24;">
                                                <div><i class="fas fa-truck-moving text-warning"></i> Yêu cầu điều chuyển <small class="text-muted">· @ycTen · x@(yc.SoLuong)</small></div>
                                                <div class="ql-muted" style="font-size:0.7rem;">Gửi từ showroom: <strong class="ql-strong">@(yc.ChiNhanhDich?.TenChiNhanh ?? yc.MaChiNhanhDich)</strong> yêu cầu nhận từ <strong class="ql-strong">@(yc.ChiNhanhNguon?.TenChiNhanh ?? yc.MaChiNhanhNguon)</strong></div>
                                                <div class="ql-muted" style="font-size:0.7rem;">Đơn cọc: <strong class="ql-strong">#@yc.MaDonCoc</strong> · Gửi lúc @yc.NgayGui.ToString("dd/MM/yyyy HH:mm")</div>
                                                <div class="d-flex flex-wrap gap-2 mt-1" id="yc-@yc.MaYeuCau">
                                                    <form method="post" asp-page-handler="XacNhanDieuChuyen" onsubmit="return confirm('Xác nhận điều chuyển @yc.SoLuong xe này? Xe sẽ được trừ khỏi showroom của bạn và chuyển sang showroom đích.');">
                                                        <input type="hidden" name="maYeuCau" value="@yc.MaYeuCau" />
                                                        <button type="submit" class="btn btn-success btn-sm"><i class="fas fa-check"></i> Xác nhận điều chuyển</button>
                                                    </form>
                                                    <button type="button" class="btn btn-danger btn-sm" onclick="openTuChoiDieuChuyen(@yc.MaYeuCau, '@(ycTen.Replace("'", "\\'"))', '@(yc.ChiNhanhDich?.TenChiNhanh ?? yc.MaChiNhanhDich)')">
                                                        <i class="fas fa-times"></i> Từ chối
                                                    </button>
                                                </div>
                                            </div>
                                        }
                                    }
                                    @{
                                        var ycDiCuaDon = Model.DanhSachYeuCauDi.Where(y => y.MaDonCoc == d.MaDonCoc).ToList();
                                    }
                                    @if (ycDiCuaDon.Any())
                                    {
                                        foreach (var yc in ycDiCuaDon)
                                        {
                                            var ycTen = $"{yc.ChiTiet?.PhienBan?.DongXe?.TenDong ?? ""} {yc.ChiTiet?.PhienBan?.TenPhienBan ?? ""}".Trim();
                                            var ycState = yc.TrangThai switch
                                            {
                                                "Đã xác nhận" => "<span class='badge badge-confirmed'>Đã xác nhận</span>",
                                                "Đã từ chối" => "<span class='badge badge-rejected'>Đã từ chối</span>" + (string.IsNullOrEmpty(yc.LyDoTuChoi) ? "" : "<br><small class='text-muted'>" + (yc.LyDoTuChoi ?? "").Replace("\r\n", " ") + "</small>"),
                                                "Đã hủy" => "<span class='badge badge-cancelled'>Đã huỷ</span>",
                                                "Đã huỷ" => "<span class='badge badge-cancelled'>Đã huỷ</span>",
                                                _ => "<span class='badge badge-waiting'>Chờ showroom nguồn xác nhận</span>"
                                            };
                                            <div class="ql-bordered" style="padding:0.5rem;margin-bottom:0.4rem;border-left:4px solid #93c5fd;">
                                                <div><i class="fas fa-paper-plane text-info"></i> Yêu cầu điều chuyển <small class="text-muted">· @ycTen</small></div>
                                                <div class="ql-muted" style="font-size:0.7rem;">Showroom nguồn: <strong class="ql-strong">@(yc.ChiNhanhNguon?.TenChiNhanh ?? yc.MaChiNhanhNguon)</strong> → <strong class="ql-strong">@(yc.ChiNhanhDich?.TenChiNhanh ?? yc.MaChiNhanhDich)</strong></div>
                                                <div class="ql-muted" style="font-size:0.7rem;">Số lượng: <strong class="ql-strong">@yc.SoLuong xe</strong> · Gửi lúc @yc.NgayGui.ToString("dd/MM/yyyy HH:mm")</div>
                                                <div class="d-flex align-items-center gap-2 flex-wrap mt-1">
                                                    @Html.Raw(ycState)
                                                    @if (yc.TrangThai == "Chờ xác nhận")
                                                    {
                                                        <button type="button" class="btn btn-outline-danger btn-sm" onclick="openHuyYeuCau(@yc.MaYeuCau, '@(ycTen.Replace("'", "\\'"))', @yc.SoLuong)">
                                                            <i class="fas fa-times"></i> Huỷ yêu cầu
                                                        </button>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    }
                                </td>
                                <td>@d.SoTienCoc.ToString("N0")đ</td>
                                <td>@d.NgayTaoDon.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @switch (d.TrangThaiDonHang)
                                    {
                                        case "Chờ xác nhận":
                                            <span class="badge badge-waiting">Chờ xác nhận</span>
                                            break;
                                        case "Đã xác nhận":
                                            <span class="badge badge-confirmed">Đã xác nhận</span>
                                            break;
                                        case "Hoàn tất":
                                            <span class="badge badge-completed">Hoàn tất</span>
                                            break;
                                        case "Đã từ chối":
                                            <span class="badge badge-rejected">Đã từ chối</span>
                                            break;
                                        case "Đã hủy":
                                            <span class="badge badge-cancelled">Đã hủy</span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary">@d.TrangThaiDonHang</span>
                                            break;
                                    }
                                    <div class="ql-muted" style="font-size:0.7rem;margin-top:0.3rem;line-height:1.3;">
                                        @(string.Equals(d.PhuongThucThanhToan, "Tiền mặt", StringComparison.OrdinalIgnoreCase) ? "Đơn tiền cọc" : "Đơn chuyển khoản")
                                        @if (!string.IsNullOrWhiteSpace(d.TrangThaiThanhToan)) { <span class="text-muted">· @d.TrangThaiThanhToan</span> }
                                    </div>
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(d.ToaDoGap))
                                    {
                                        <div data-map-latlng="@d.ToaDoGap" style="width:100%;height:120px;border-radius:6px;border:1px solid rgba(255,255,255,0.1);background:#10141f;"></div>
                                        <div class="ql-muted" style="font-size:0.72rem;margin-top:0.25rem;max-width:220px;">@(d.DiaDiemGap ?? "")</div>
                                        <button type="button" class="btn btn-outline-primary btn-sm mt-1" onclick="openQlMap('@d.ToaDoGap', '@((d.DiaDiemGap ?? "").Replace("'", "\\'"))', '#@d.MaDonCoc')">
                                            <i class="fas fa-map-marked-alt"></i> Xem bản đồ lớn
                                        </button>
                                        <a class="btn btn-outline-success btn-sm mt-1" target="_blank" rel="noopener" href="https://www.google.com/maps?q=@d.ToaDoGap">
                                            <i class="fas fa-location-arrow"></i> Mở Google Maps: @d.ToaDoGap
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="ql-muted" style="font-size:0.75rem;">—</span>
                                    }
                                </td>
                                <td>
                                    @if (d.MaChiNhanh == Model.Showroom?.MaChiNhanh && string.Equals(d.PhuongThucThanhToan, "Tiền mặt", StringComparison.OrdinalIgnoreCase) && d.TrangThaiThanhToan != "Đã thanh toán" && d.TrangThaiDonHang != "Hoàn tất" && d.TrangThaiDonHang != "Đã hủy" && d.TrangThaiDonHang != "Đã từ chối")
                                    {
                                        <form method="post" asp-page-handler="ConfirmCashReceived" class="mb-1" onsubmit="return confirm('Xác nhận đã nhận TIỀN CỌC (tiền mặt) của đơn này?');">
                                            <input type="hidden" name="maDonCoc" value="@d.MaDonCoc" />
                                            <button type="submit" class="btn btn-success btn-sm">
                                                <i class="fas fa-money-bill-wave"></i> Xác nhận đã nhận tiền cọc
                                            </button>
                                        </form>
                                    }
                                    @if (d.MaChiNhanh == Model.Showroom?.MaChiNhanh && d.TrangThaiDonHang == "Chờ thanh toán")
                                    {
                                        <button type="button" class="btn btn-outline-danger btn-sm mb-1" onclick="openCancelDeposit(@d.MaDonCoc, '@((d.HoTen ?? "").Replace("'", "\\'"))')">
                                            <i class="fas fa-times-circle"></i> Huỷ đặt cọc
                                        </button>
                                    }
                                    @if (d.MaChiNhanh == Model.Showroom?.MaChiNhanh && d.TrangThaiDonHang == "Chờ xác nhận" && (d.PhuongThucThanhToan != "Tiền mặt" || d.TrangThaiThanhToan == "Đã thanh toán") && d.ChiTiets.Any() && d.ChiTiets.All(c => c.TrangThaiTiepNhan == "Đã tiếp nhận"))
                                    {
                                        <form method="post" asp-page-handler="AcceptOrder" onsubmit="return confirmAccept(event);">
                                            <input type="hidden" name="maDonCoc" value="@d.MaDonCoc" />
                                            <div class="input-group input-group-sm mb-1" style="max-width:220px;">
                                                <span class="input-group-text"><i class="fas fa-clock"></i></span>
                                                <input type="datetime-local" name="ngayHenNhanXe" class="form-control" required />
                                            </div>
                                            <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-check"></i> Tiếp nhận đơn cọc</button>
                                        </form>
                                    }
                                    @if (d.MaChiNhanh == Model.Showroom?.MaChiNhanh && (d.TrangThaiDonHang == "Chờ xác nhận" || d.TrangThaiDonHang == "Chờ xử lý"))
                                    {
                                        <button type="button" class="btn btn-outline-danger btn-sm mt-1" onclick="openDeclineOrder(@d.MaDonCoc, '@((d.HoTen ?? "").Replace("'", "\\'"))', @((d.TrangThaiDonHang == "Chờ xử lý") ? "true" : "false"))">
                                            <i class="fas fa-ban"></i> Từ chối đơn cọc
                                        </button>
                                    }
                                    @if (d.MaChiNhanh == Model.Showroom?.MaChiNhanh
                                        && (d.PhuongThucThanhToan != "Tiền mặt" || d.TrangThaiThanhToan == "Đã thanh toán")
                                        && Model.ThieuXeTheoDon.ContainsKey(d.MaDonCoc))
                                    {
                                        <div class="ql-bordered ql-nhap-options" style="margin-top:0.4rem;padding:0.5rem;">
                                            <div class="ql-strong" style="font-size:0.8rem;margin-bottom:0.3rem;"><i class="fas fa-box-open"></i> Xử lý thiếu xe</div>
                                            <div class="ql-muted" style="font-size:0.7rem;margin-bottom:0.4rem;">
                                                @Model.ThieuXeTheoDon[d.MaDonCoc].Count loại xe đang thiếu.
                                            </div>
                                            @foreach (var it in Model.ThieuXeTheoDon[d.MaDonCoc])
                                            {
                                                @foreach (var g in it.DaGui)
                                                {
                                                    <div class="ql-bordered" style="font-size:0.72rem;padding:0.3rem 0.5rem;margin-bottom:0.3rem;border-left:4px solid #93c5fd;">
                                                        <i class="fas fa-paper-plane text-info"></i> <strong>@it.TenXe</strong>: đã gửi yêu cầu <strong>@g.SoLuong</strong> xe tới <strong>@g.TenChiNhanh</strong> <span class="badge badge-waiting">Chờ xác nhận</span>
                                                    </div>
                                                }
                                            }
                                            <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap">
                                                <button type="button" class="btn btn-warning btn-sm" style="flex:1 1 0; min-width:120px; white-space:nowrap;" onclick="openNhapHangOrder(@d.MaDonCoc)">
                                                    <i class="fas fa-box"></i> Nhập hàng
                                                </button>
                                                <button type="button" class="btn btn-info btn-sm" style="flex:1 1 0; min-width:170px; white-space:nowrap;" onclick="openDieuChuyenOrder(@d.MaDonCoc)">
                                                    <i class="fas fa-truck-moving"></i> Nhập từ showroom khác
                                                </button>
                                            </div>
                                            <div class="ql-muted" style="font-size:0.68rem;margin-top:0.35rem;">Nhập hàng = nhập xe mới về showroom của bạn. Nhập từ showroom khác = tạo yêu cầu điều chuyển (chờ họ xác nhận).</div>
                                        </div>
                                    }
                                    @if (d.MaChiNhanh == Model.Showroom?.MaChiNhanh && d.TrangThaiDonHang == "Đã xác nhận")
                                    {
                                        <form method="post" asp-page-handler="Sold" onsubmit="return confirm('Xác nhận bán xe và tạo hoá đơn?');">
                                            <input type="hidden" name="maDonCoc" value="@d.MaDonCoc" />
                                            <button type="submit" class="btn btn-success btn-sm"><i class="fas fa-receipt"></i> Bán thành công</button>
                                        </form>
                                    }
                                    @if (d.MaChiNhanh == Model.Showroom?.MaChiNhanh && (d.TrangThaiDonHang == "Đã xác nhận" || d.TrangThaiDonHang == "Hoàn tất"))
                                    {
                                        <form method="post" asp-page-handler="CancelSale" class="mt-1" onsubmit="return confirm('Xác nhận KHÔNG BÁN / hủy giao dịch này? Tiền cọc sẽ được hoàn lại.');">
                                            <input type="hidden" name="maDonCoc" value="@d.MaDonCoc" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm"><i class="fas fa-ban"></i> Không bán</button>
                                        </form>
                                    }
                                    @if (d.TrangThaiDonHang == "Hoàn tất")
                                    {
                                        var hd = Model.HoaDonList.FirstOrDefault(h => h.MaDonCoc == d.MaDonCoc);
                                        if (hd != null)
                                        {
                                            <div class="ql-bordered" style="padding:0.5rem;min-width:220px;">
                                                <div class="ql-strong" style="font-size:0.85rem;"><i class="fas fa-file-invoice-dollar"></i> @hd.MaHoaDon</div>
                                                <div class="ql-muted" style="font-size:0.75rem;">Cơ sở: <strong class="ql-strong">@(Model.Showroom?.TenChiNhanh)</strong></div>
                                                <div class="ql-muted" style="font-size:0.75rem;">Khách: <strong class="ql-strong">@d.HoTen</strong> (@d.SoDienThoai)</div>
                                                <div class="ql-muted" style="font-size:0.75rem;">Tổng: <strong class="ql-strong">@hd.TongTienPhaiTra.ToString("N0")đ</strong> · Cọc: @hd.SoTienDaThanhToan.ToString("N0")đ · Còn: <strong class="ql-strong">@((hd.TongTienPhaiTra - hd.SoTienDaThanhToan).ToString("N0"))đ</strong></div>
                                            </div>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

