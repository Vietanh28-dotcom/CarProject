function refreshBrandUi(id, tenHang, quocGia, logoUrl) {
    var esc = function (s) { return (s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;'); };
    var brandItems = document.querySelectorAll('.brand-item[data-mahang="' + id + '"]');
    brandItems.forEach(function (item) {
        var letter = item.querySelector('.brand-letter');
        if (letter) {
            if (logoUrl) {
                letter.style.background = 'transparent';
                letter.innerHTML = '<img src="' + esc(logoUrl) + '?v=' + Date.now() + '" alt="' + esc(tenHang) + '" style="width:48px;height:48px;object-fit:contain;border-radius:50%;" />';
            } else {
                letter.style.background = '';
                letter.innerHTML = esc(tenHang.charAt(0));
            }
        }
        var h6 = item.querySelector('h6');
        if (h6) h6.textContent = tenHang;
        var p = item.querySelector('p');
        if (p) p.textContent = quocGia;
    });
    var row = document.querySelector('#brandListContainer .banner-row[data-id="' + id + '"]');
    if (row) {
        row.setAttribute('data-ten', tenHang);
        var img = row.querySelector('img');
        if (logoUrl) {
            if (img) {
                img.src = logoUrl + '?v=' + Date.now();
                img.style.visibility = 'visible';
            } else {
                var letterSpan = row.querySelector('.brand-row-letter');
                if (letterSpan) letterSpan.outerHTML = '<img src="' + esc(logoUrl) + '?v=' + Date.now() + '" alt="' + esc(tenHang) + '" onerror="this.style.visibility=\'hidden\';" style="width:40px;height:40px;object-fit:contain;border-radius:50%;" />';
            }
        } else {
            if (img) {
                var nameSpan = row.querySelector('.brand-name');
                img.outerHTML = '<span class="brand-row-letter" style="width:40px;height:40px;flex:0 0 40px;border-radius:50%;background:var(--brand-gray);color:var(--brand-white);display:flex;align-items:center;justify-content:center;font-weight:800;font-size:1rem;">' + esc(tenHang.charAt(0)) + '</span>';
            }
        }
        var nameEl = row.querySelector('.brand-name');
        if (nameEl) { nameEl.textContent = tenHang; nameEl.title = tenHang; }
    }
}

