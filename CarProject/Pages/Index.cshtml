<!-- Image Crop Modal -->
<div class="crop-overlay" id="cropOverlay">
    <div class="crop-dialog">
        <div class="crop-header">
            <h6><i class="fas fa-crop-alt me-2"></i> Chỉnh sửa ảnh</h6>
            <button class="btn-close-crop" onclick="closeCropModal()">&times;</button>
        </div>
        <div class="crop-viewport" id="cropViewport">
            <img id="cropImage" src="" alt="Crop" />
            <div class="crop-frame"></div>
            <div class="crop-guide"></div>
        </div>
        <div class="crop-controls">
            <div class="crop-zoom-row">
                <label><i class="fas fa-search-plus"></i></label>
                <input type="range" id="cropZoom" min="10" max="300" value="100" oninput="onCropZoom()" />
                <span class="zoom-val" id="cropZoomVal">100%</span>
            </div>
            <div class="crop-ratio-row">
                <label>Tỷ lệ:</label>
                <button class="crop-ratio-btn active" data-ratio="free" onclick="setCropRatio('free',this)">Tự do</button>
                <button class="crop-ratio-btn" data-ratio="16:9" onclick="setCropRatio('16:9',this)">16:9</button>
                <button class="crop-ratio-btn" data-ratio="4:3" onclick="setCropRatio('4:3',this)">4:3</button>
                <button class="crop-ratio-btn" data-ratio="1:1" onclick="setCropRatio('1:1',this)">1:1</button>
                <button class="crop-ratio-btn" data-ratio="3:2" onclick="setCropRatio('3:2',this)">3:2</button>
            </div>
        </div>
        <div class="crop-actions">
            <button class="crop-btn-cancel" onclick="closeCropModal()">Hủy</button>
            <button class="crop-btn-reset" onclick="resetCropPosition()"><i class="fas fa-arrows-alt me-1"></i> Đặt lại</button>
            <button class="crop-btn-apply" onclick="applyCrop()"><i class="fas fa-check me-1"></i> Áp dụng</button>
        </div>
        <div class="crop-status" id="cropStatus"></div>
    </div>
</div>

@section Scripts {
<script>
let _carVersions = [];
let _carImages = [];

/* ========== IMAGE CROP SYSTEM ========== */
let _cropState = { targetInputId: null, zoom: 1, ratio: 'free', drag: {x:0,y:0}, isDragging: false, imgW: 0, imgH: 0 };
let _croppedBlobs = {};

const _urlInputMap = {
    bannerFileInput:'bannerUrlInput', editBrandFile:'editBrandLogo', editModelFile:'editModelImage', editVerFile:'editVerImage',
    brandEditFile:'brandEditLogo'
};

function openCropModal(inputId, aspectRatio) {
    const input = document.getElementById(inputId);
    if (!input) return;
    _cropState.targetInputId = inputId;
    _cropState.ratio = aspectRatio || 'free';
    _cropState.zoom = 1;

    const overlay = document.getElementById('cropOverlay');
    const img = document.getElementById('cropImage');
    const zoomSlider = document.getElementById('cropZoom');
    zoomSlider.value = 100;
    document.getElementById('cropZoomVal').textContent = '100%';

    document.querySelectorAll('.crop-ratio-btn').forEach(b => {
        b.classList.toggle('active', b.dataset.ratio === _cropState.ratio);
    });

    let src = '';
    if (input.files && input.files.length > 0) {
        src = URL.createObjectURL(input.files[0]);
    } else {
        src = input.value.trim();
        if (!src) {
            const urlId = _urlInputMap[inputId];
            if (urlId) {
                const urlInput = document.getElementById(urlId);
                if (urlInput) src = urlInput.value.trim();
            }
        }
    }
    if (!src) { alert('Vui lòng chọn ảnh hoặc nhập URL trước.'); return; }

    function setCropSrc(url) {
        img.onload = function() {
            _cropState.imgW = img.naturalWidth;
            _cropState.imgH = img.naturalHeight;
            _cropState.zoom = 1;
            centerCropDrag();
            fitCropImage();
            updateCropFrame();
        };
        img.src = url;
        overlay.classList.add('active');
    }

    if (src.startsWith('http://') || src.startsWith('https://')) {
        fetch('/api/image-proxy?url=' + encodeURIComponent(src)).then(r => r.blob()).then(blob => {
            setCropSrc(URL.createObjectURL(blob));
        }).catch(() => setCropSrc(src));
    } else {
        setCropSrc(src);
    }
}

function baseScale() {
    const vp = document.getElementById('cropViewport');
    return Math.min(vp.clientWidth / _cropState.imgW, vp.clientHeight / _cropState.imgH) * 0.9;
}

function centerCropDrag() {
    const vp = document.getElementById('cropViewport');
    const vw = vp.clientWidth, vh = vp.clientHeight;
    const iw = _cropState.imgW, ih = _cropState.imgH;
    if (!iw || !ih) return;
    const s = baseScale() * _cropState.zoom;
    _cropState.drag.x = (vw - iw * s) / 2;
    _cropState.drag.y = (vh - ih * s) / 2;
}

function fitCropImage() {
    const viewport = document.getElementById('cropViewport');
    const img = document.getElementById('cropImage');
    const vw = viewport.clientWidth;
    const vh = viewport.clientHeight;
    const iw = _cropState.imgW, ih = _cropState.imgH;
    if (!iw || !ih) return;
    const scale = baseScale() * _cropState.zoom;
    img.style.width = (iw * scale) + 'px';
    img.style.height = (ih * scale) + 'px';
    img.style.left = _cropState.drag.x + 'px';
    img.style.top = _cropState.drag.y + 'px';
}

/* Zoom từ TÂM ảnh: giữ điểm trung tâm ảnh cố định trên viewport khi phóng/thu */
function applyCropZoom(val) {
    val = Math.max(10, Math.min(300, val));
    const base = baseScale();
    const oldW = _cropState.imgW * base * _cropState.zoom;
    const oldH = _cropState.imgH * base * _cropState.zoom;
    const cx = _cropState.drag.x + oldW / 2;
    const cy = _cropState.drag.y + oldH / 2;
    _cropState.zoom = val / 100;
    const newW = _cropState.imgW * base * _cropState.zoom;
    const newH = _cropState.imgH * base * _cropState.zoom;
    _cropState.drag.x = cx - newW / 2;
    _cropState.drag.y = cy - newH / 2;
    document.getElementById('cropZoom').value = val;
    document.getElementById('cropZoomVal').textContent = val + '%';
    fitCropImage();
}

function onCropZoom() {
    applyCropZoom(parseInt(document.getElementById('cropZoom').value));
}

function resetCropPosition() {
    _cropState.zoom = 1;
    centerCropDrag();
    document.getElementById('cropZoom').value = 100;
    document.getElementById('cropZoomVal').textContent = '100%';
    fitCropImage();
}

function setCropRatio(ratio, btn) {
    _cropState.ratio = ratio;
    document.querySelectorAll('.crop-ratio-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    updateCropFrame();
}

function updateCropFrame() {
    const viewport = document.getElementById('cropViewport');
    const frame = viewport.querySelector('.crop-frame');
    const vw = viewport.clientWidth, vh = viewport.clientHeight;
    if (_cropState.ratio === 'free') {
        frame.style.inset = '0';
    } else {
        const p = _cropState.ratio.split(':');
        const rW = parseInt(p[0]), rH = parseInt(p[1]);
        let fw, fh;
        if (vw / vh > rW / rH) { fh = vh * 0.85; fw = fh * rW / rH; }
        else { fw = vw * 0.85; fh = fw * rH / rW; }
        const top = (vh - fh) / 2, left = (vw - fw) / 2;
        frame.style.top = top + 'px';
        frame.style.left = left + 'px';
        frame.style.right = 'auto';
        frame.style.bottom = 'auto';
        frame.style.width = fw + 'px';
        frame.style.height = fh + 'px';
    }
}

function closeCropModal() {
    document.getElementById('cropOverlay').classList.remove('active');
}

function applyCrop() {
    const viewport = document.getElementById('cropViewport');
    const img = document.getElementById('cropImage');
    const vw = viewport.clientWidth, vh = viewport.clientHeight;
    const iw = _cropState.imgW, ih = _cropState.imgH;
    if (!iw || !ih) { alert('Ảnh chưa được tải xong. Vui lòng thử lại.'); return; }

    // Khung cắt giống hệt frame người dùng đang thấy (updateCropFrame)
    let fw = vw, fh = vh, fl = 0, ft = 0;
    if (_cropState.ratio !== 'free') {
        const p = _cropState.ratio.split(':');
        const rW = parseInt(p[0]), rH = parseInt(p[1]);
        if (vw / vh > rW / rH) { fh = vh * 0.85; fw = fh * rW / rH; }
        else { fw = vw * 0.85; fh = fw * rH / rW; }
        fl = (vw - fw) / 2; ft = (vh - fh) / 2;
    }

    // Toạ độ vùng cắt trên ảnh GỐC (pixel gốc)
    const imgRect = img.getBoundingClientRect();
    const vpRect = viewport.getBoundingClientRect();
    const scaleX = imgRect.width / iw;   // px hiển thị / px gốc
    const scaleY = imgRect.height / ih;
    const frameLeft = vpRect.left + fl;
    const frameTop = vpRect.top + ft;
    let sx = (frameLeft - imgRect.left) / scaleX;
    let sy = (frameTop - imgRect.top) / scaleY;
    let sw = fw / scaleX;
    let sh = fh / scaleY;

    // Clamp vào biên ảnh gốc — chống vùng đen/vỡ ảnh
    if (sx < 0) { sx = 0; }
    if (sy < 0) { sy = 0; }
    if (sx + sw > iw) { sw = iw - sx; }
    if (sy + sh > ih) { sh = ih - sy; }
    if (sw <= 0 || sh <= 0) { alert('Vùng cắt nằm ngoài ảnh. Vui lòng kéo ảnh vào trong khung.'); return; }

    // Xuất ảnh ở ĐỘ PHÂN GIẢI GỐC của vùng cắt (không bị mờ khi hiển thị fullscreen)
    const canvas = document.createElement('canvas');
    canvas.width = Math.max(1, Math.round(sw));
    canvas.height = Math.max(1, Math.round(sh));
    const ctx = canvas.getContext('2d');
    ctx.imageSmoothingEnabled = true;
    ctx.imageSmoothingQuality = 'high';
    ctx.drawImage(img, sx, sy, sw, sh, 0, 0, canvas.width, canvas.height);

    canvas.toBlob(function(blob) {
        if (blob && _cropState.targetInputId) {
            _croppedBlobs[_cropState.targetInputId] = blob;
            const tag = document.getElementById('cropStatus');
            if (tag) tag.textContent = 'Thành công ✓';
        }
        closeCropModal();
        showToast('Đã áp dụng crop! Tiếp tục bấm Lưu.','success');
    }, 'image/jpeg', 0.95);
}

/* Drag to pan */
document.addEventListener('DOMContentLoaded', function() {
    const vp = document.getElementById('cropViewport');
    if (!vp) return;
    let startX, startY, sdx, sdy;
    vp.addEventListener('mousedown', e => {
        e.preventDefault();
        _cropState.isDragging = true;
        startX = e.clientX; startY = e.clientY;
        sdx = _cropState.drag.x; sdy = _cropState.drag.y;
    });
    document.addEventListener('mousemove', e => {
        if (!_cropState.isDragging) return;
        _cropState.drag.x = sdx + (e.clientX - startX);
        _cropState.drag.y = sdy + (e.clientY - startY);
        fitCropImage();
    });
    document.addEventListener('mouseup', () => { _cropState.isDragging = false; });
    vp.addEventListener('wheel', e => {
        e.preventDefault();
        const delta = e.deltaY > 0 ? -10 : 10;
        applyCropZoom(parseInt(document.getElementById('cropZoom').value) + delta);
    }, { passive: false });
});

/* Upload: use cropped blob if available, else original file */
async function uploadFile(file, inputId) {
    let blob = (inputId && _croppedBlobs[inputId]) ? _croppedBlobs[inputId] : file;
    const formData = new FormData();
    formData.append('file', blob, blob.name || 'cropped.jpg');
    try {
        const res = await fetch('/api/admin/upload', { method: 'POST', body: formData });
        if (!res.ok) throw new Error(res.statusText);
        const data = await res.json();
        if (inputId) delete _croppedBlobs[inputId];
        return data.url;
    } catch (e) { alert('Upload thất bại. Thử dán URL ảnh thay thế.'); return null; }
}

function fileOrCrop(fileInput, inputId) {
    if (fileInput.files.length > 0) return fileInput.files[0];
    const b = _croppedBlobs[inputId];
    return b ? new File([b], 'cropped.jpg', { type: 'image/jpeg' }) : null;
}
/* ======================================== */

function openBannerEditor() { new bootstrap.Modal(document.getElementById('bannerEditorModal')).show(); }

function openBrandListEditor() { new bootstrap.Modal(document.getElementById('brandListModal')).show(); }

async function deleteBrand(id, name) {
    if (!confirm('Xoá thương hiệu "' + name + '"?')) return;
    try {
        const res = await apiPost('/api/admin/hangxe/delete', { maHang: id });
        showToast('Đã xoá thương hiệu!');
        setTimeout(() => location.reload(true), 1200);
    } catch (e) { showToast('Lỗi xoá thương hiệu: ' + e.message, 'error'); }
}

/* ===== Hero banner slideshow ===== */
let _heroSlideIdx = 0;
let _heroSlideTimer = null;

function goHeroSlide(i) {
    const slides = document.querySelectorAll('.hero-banner-slide');
    const dots = document.querySelectorAll('.hero-banner-dot');
    if (!slides.length) return;
    const total = slides.length;
    _heroSlideIdx = ((i % total) + total) % total;
    slides.forEach((s, n) => s.classList.toggle('active', n === _heroSlideIdx));
    dots.forEach((d, n) => d.classList.toggle('active', n === _heroSlideIdx));
}

function initHeroSlider() {
    const slides = document.querySelectorAll('.hero-banner-slide');
    if (slides.length < 2) return;
    if (_heroSlideTimer) clearInterval(_heroSlideTimer);
    _heroSlideTimer = setInterval(() => goHeroSlide(_heroSlideIdx + 1), 6000);
}

document.addEventListener('DOMContentLoaded', initHeroSlider);

async function deleteBanner(id) {
    if (!confirm('Xoá banner này?')) return;
    try {
        const res = await apiPost('/api/admin/banner/delete', { maBanner: id });
        showToast('Đã xoá banner!');
        setTimeout(() => location.reload(true), 1200);
    } catch (e) { showToast('Lỗi xoá banner: ' + e.message, 'error'); }
}

function deleteCurrentHeroBanner() {
    const active = document.querySelector('.hero-banner-slide.active');
    if (!active) { showToast('Không có banner đang hiển thị', 'error'); return; }
    const id = active.getAttribute('data-mabanner');
    if (!id) { showToast('Không tìm thấy banner đang hiển thị', 'error'); return; }
    deleteBanner(parseInt(id));
}

function openBrandEditor(id, name, country, logo) {
    document.getElementById('brandEditId').value = id;
    document.getElementById('brandEditName').value = name;
    document.getElementById('brandEditCountry').value = country;
    document.getElementById('brandEditLogo').value = logo;
    new bootstrap.Modal(document.getElementById('brandEditorModal')).show();
}

function openCarEditorFull(id) {
    fetch('/api/admin/dongxe/' + id).then(r=>r.json()).then(d=>{
        _carVersions = d.versions || [];
        _carImages = d.images || [];
        if (d.brand) {
            document.getElementById('editBrandId').value = d.brand.maHang;
            document.getElementById('editBrandName').value = d.brand.tenHang;
            document.getElementById('editBrandCountry').value = d.brand.quocGia;
            document.getElementById('editBrandLogo').value = d.brand.duongDanLogo || '';
        }
        document.getElementById('editModelId').value = d.maDong;
        document.getElementById('editModelName').value = d.tenDong;
        document.getElementById('editModelBrand').value = d.maHang;
        document.getElementById('editModelStyle').value = d.kieuDang;
        document.getElementById('editModelImage').value = d.duongDanAnh || '';
        renderModelImages();
        const sel = document.getElementById('editVersionSelect');
        sel.innerHTML = '';
        _carVersions.forEach((v,i) => {
            const opt = document.createElement('option');
            opt.value = i; opt.text = v.tenPhienBan + ' - ' + (v.giaNiemYet ? v.giaNiemYet.toLocaleString('vi-VN') + 'đ' : 'Liên hệ');
            sel.appendChild(opt);
        });
        if (_carVersions.length > 0) loadVersionData();
        const modal = new bootstrap.Modal(document.getElementById('carEditorModal'));
        modal.show();
    });
}

function loadVersionData() {
    const idx = parseInt(document.getElementById('editVersionSelect').value);
    const v = _carVersions[idx];
    if (!v) return;
    document.getElementById('editVerId').value = v.maPhienBan;
    document.getElementById('editVerName').value = v.tenPhienBan;
    document.getElementById('editVerPrice').value = v.giaNiemYet || '';
    document.getElementById('editVerColor').value = v.mauSac || '';
    document.getElementById('editVerEngine').value = v.dongCo || '';
    document.getElementById('editVerTransmission').value = v.hopSo || '';
    document.getElementById('editVerFuel').value = v.loaiNhietLieu || 'Xăng';
    document.getElementById('editVerStock').value = v.soLuongTrongKho || 0;
    document.getElementById('editVerStatus').value = v.trangThai || 'Còn hàng';
    document.getElementById('editVerPromo').value = v.maKhuyenMai || '';
    document.getElementById('editVerImage').value = v.duongDanAnh || '';
}

function showToast(msg, type) {
    const c = document.getElementById('toastContainer');
    if (!c) return;
    const el = document.createElement('div');
    el.className = 'toast-item toast-visible' + (type === 'error' ? ' toast-error' : '');
    el.innerHTML = '<div class="toast-icon">' + (type === 'error' ? '<i class="fas fa-exclamation-circle"></i>' : '<i class="fas fa-check-circle"></i>') + '</div>'
        + '<div class="toast-body"><div class="toast-title">' + (type === 'error' ? 'Lỗi' : 'Thành công') + '</div><div class="toast-msg">' + msg + '</div></div>'
        + '<button class="toast-close" onclick="this.parentElement.remove()"><i class="fas fa-times"></i></button>'
        + '<div class="toast-progress"><div class="toast-progress-bar" style="animation:toastProgress 3s linear forwards;"></div></div>';
    c.appendChild(el);
    setTimeout(() => { el.classList.add('toast-hide'); setTimeout(() => el.remove(), 400); }, 3000);
}

async function apiPost(url, payload) {
    const res = await fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
    });
    const data = await res.json();
    if (!res.ok || data.error) throw new Error(data.error || res.statusText);
    return data;
}

function renderModelImages() {
    const list = document.getElementById('editModelImagesList');
    if (!list) return;
    if (!_carImages.length) {
        list.innerHTML = '<span class="text-muted" style="font-size:0.72rem;">Chưa có ảnh nào.</span>';
        return;
    }
    list.innerHTML = _carImages.map(function (img) {
        return '<div class="position-relative" style="width:80px;height:56px;border-radius:8px;overflow:hidden;border:2px solid ' + (img.laChinh ? 'var(--brand-gold)' : 'rgba(255,255,255,0.1)') + ';">'
            + '<img src="' + img.duongDanAnh + '" alt="" style="width:100%;height:100%;object-fit:cover;display:block;" onerror="this.style.visibility=\'hidden\';" />'
            + (img.laChinh ? '<span style="position:absolute;top:2px;left:2px;background:var(--brand-gold);color:#000;font-size:0.6rem;padding:0 4px;border-radius:4px;font-weight:700;"><i class="fas fa-star"></i></span>' : '')
            + '<div class="d-flex" style="position:absolute;bottom:2px;right:2px;gap:3px;">'
            + (img.laChinh ? '' : '<button type="button" class="btn btn-dark btn-sm p-0" style="width:20px;height:20px;font-size:0.6rem;border-radius:4px;opacity:0.9;" title="Đặt ảnh chính" onclick="setMainCarImage(' + img.maHinhAnh + ')"><i class="fas fa-star"></i></button>')
            + '<button type="button" class="btn btn-danger btn-sm p-0" style="width:20px;height:20px;font-size:0.6rem;border-radius:4px;opacity:0.9;" title="Xoá ảnh" onclick="deleteCarImage(' + img.maHinhAnh + ')"><i class="fas fa-trash"></i></button>'
            + '</div></div>';
    }).join('');
}

async function uploadModelImages(files) {
    if (!files || !files.length) return;
    const maDong = parseInt(document.getElementById('editModelId').value);
    if (!maDong) { showToast('Chưa có mã dòng xe', 'error'); return; }
    try {
        const formData = new FormData();
        for (const f of files) formData.append('files', f);
        const res = await fetch('/api/admin/dongxe/images/upload', { method: 'POST', body: formData });
        const data = await res.json();
        if (!res.ok || !data.urls || !data.urls.length) throw new Error(data.error || 'Upload thất bại');
        const existing = _carImages.map(i => ({ duongDanAnh: i.duongDanAnh, laChinh: i.laChinh }));
        for (const url of data.urls) existing.push({ duongDanAnh: url, laChinh: false });
        const saved = await apiPost('/api/admin/dongxe/images/save', { maDong: maDong, images: existing });
        _carImages = saved.images || [];
        document.getElementById('editModelImagesFiles').value = '';
        renderModelImages();
        showToast('Đã thêm ' + data.urls.length + ' ảnh!');
    } catch (e) { showToast('Lỗi upload ảnh: ' + e.message, 'error'); }
}

async function setMainCarImage(maHinhAnh) {
    try {
        const res = await apiPost('/api/admin/dongxe/images/setmain', { maHinhAnh: maHinhAnh });
        _carImages = res.images || _carImages.map(i => ({ ...i, laChinh: i.maHinhAnh === maHinhAnh }));
        renderModelImages();
        showToast('Đã đặt ảnh chính!');
    } catch (e) { showToast('Lỗi: ' + e.message, 'error'); }
}

async function deleteCarImage(maHinhAnh) {
    if (!confirm('Xoá ảnh này?')) return;
    try {
        const res = await apiPost('/api/admin/dongxe/images/delete', { maHinhAnh: maHinhAnh });
        _carImages = res.images || [];
        renderModelImages();
        showToast('Đã xoá ảnh!');
    } catch (e) { showToast('Lỗi xoá ảnh: ' + e.message, 'error'); }
}

