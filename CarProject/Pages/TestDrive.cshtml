@page
@model TestDriveModel

@{
    ViewData["Title"] = "Đăng ký lái thử";
}

<div class="deposit-page">
    <div class="container py-4">
        <nav class="breadcrumb-premium mb-4">
            <a asp-page="/Index"><i class="fas fa-home"></i> Trang chủ</a>
            <span>/</span>
            <span>Đăng ký lái thử</span>
        </nav>

        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="deposit-card p-4">
                    <h4>Gửi yêu cầu lái thử</h4>
                    <p style="color: var(--text-muted); font-size: 0.85rem; margin-bottom: 1.5rem;">
                        Hoàn toàn <strong style="color: var(--brand-gold);">miễn phí</strong>. Gửi yêu cầu và showroom sẽ chốt lịch hẹn cụ thể gửi lại cho bạn.
                    </p>

                    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
                    {
                        <div style="background: rgba(34,197,94,0.15); border: 1px solid rgba(34,197,94,0.3); color: #22c55e; padding: 0.75rem 1rem; font-size: 0.85rem; margin-bottom: 1.5rem;">
                            <i class="fas fa-check-circle me-1"></i> @Model.SuccessMessage
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div style="background: rgba(239,68,68,0.15); border: 1px solid rgba(239,68,68,0.3); color: #ef4444; padding: 0.75rem 1rem; font-size: 0.85rem; margin-bottom: 1.5rem;">
                            <i class="fas fa-exclamation-circle me-1"></i> @Model.ErrorMessage
                        </div>
                    }

                    <div asp-validation-summary="All" class="text-danger" style="font-size:0.9rem;margin-bottom:1rem;"></div>

                    <form method="post">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Họ và tên</label>
                                <input asp-for="HoTen" class="form-control" required placeholder="Nhập họ tên" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Số điện thoại</label>
                                <input asp-for="SoDienThoai" class="form-control" required placeholder="Nhập số điện thoại" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Email</label>
                                <input asp-for="Email" type="email" class="form-control" placeholder="Nhập email" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Số bằng lái xe</label>
                                <input asp-for="SoBangLaiXe" class="form-control" required placeholder="Nhập số bằng lái" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Chọn dòng xe</label>
                                <select asp-for="MaDong" class="form-control" required>
                                    <option value="">-- Chọn dòng xe --</option>
                                    @foreach (var d in Model.DanhSachXe)
                                    {
                                        <option value="@d.MaDong">@d.TenDong</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Chọn showroom</label>
                                <select asp-for="MaChiNhanh" class="form-control" required>
                                    <option value="">-- Chọn chi nhánh --</option>
                                    @foreach (var cn in Model.DanhSachChiNhanh)
                                    {
                                        <option value="@cn.MaChiNhanh">@cn.TenChiNhanh</option>
                                    }
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Ghi chú</label>
                                <textarea asp-for="GhiChu" class="form-control" rows="3" placeholder="Yêu cầu đặc biệt (nếu có)..."></textarea>
                            </div>
                        </div>

                        <div class="mt-4">
                            <button type="submit" class="btn-premium btn-premium-solid" style="padding: 0.8rem 3rem;">
                                <i class="fas fa-paper-plane me-2"></i> Gửi yêu cầu lái thử
                            </button>
                        </div>
                        <div class="mt-3" style="font-size:0.85rem;color:var(--text-muted);">
                            <i class="fas fa-info-circle me-1"></i> Miễn phí 100%. Showroom sẽ liên hệ và gửi lịch hẹn cụ thể sau khi tiếp nhận yêu cầu.
                        </div>
                    </form>

                    <div id="testDriveLoadingOverlay" style="display:none; position:fixed; inset:0; z-index:9999; background: rgba(0,0,0,0.7); backdrop-filter: blur(4px); align-items:center; justify-content:center; flex-direction:column;">
                        <div style="width:60px;height:60px;border:4px solid rgba(255,255,255,0.1);border-top-color:var(--brand-gold);border-radius:50%;animation:spin 0.8s linear infinite;margin-bottom:1.5rem;"></div>
                        <div style="color:var(--brand-white);font-size:1.1rem;font-weight:600;">Đang xử lý yêu cầu...</div>
                        <div style="color:var(--text-muted);font-size:0.82rem;margin-top:0.5rem;">Vui lòng chờ trong giây lát</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
@@keyframes spin { to { transform: rotate(360deg); } }
</style>

<script>
    document.querySelector('.deposit-page form')?.addEventListener('submit', function(e) {
        e.preventDefault();
        var form = this;
        var formData = new FormData(form);
        formData.append('_ajax', 'true');

        document.getElementById('testDriveLoadingOverlay').style.display = 'flex';

        fetch(form.action, {
            method: 'POST',
            body: new URLSearchParams(formData),
            headers: { 'RequestVerificationToken': form.querySelector('input[name="__RequestVerificationToken"]')?.value || '' }
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
            document.getElementById('testDriveLoadingOverlay').style.display = 'none';
            if (data.success) {
                if (typeof showToast === 'function') {
                    showToast(data.message || 'Đã gửi yêu cầu thành công');
                }
                setTimeout(function() { window.location.reload(); }, 1200);
            } else {
                var msg = data.error || 'Có lỗi xảy ra. Vui lòng thử lại.';
                if (data.detail) msg += '\nChi tiết: ' + data.detail;
                console.error('Lỗi gửi yêu cầu lái thử:', data.detail || data.error);
                alert(msg);
            }
        })
        .catch(function(err) {
            document.getElementById('testDriveLoadingOverlay').style.display = 'none';
            alert('Lỗi kết nối: ' + (err.message || 'Không thể kết nối máy chủ'));
        });
    });
</script>
